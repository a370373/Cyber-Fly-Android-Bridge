prefix=/data/data/com.termux/files/usr
includedir=${prefix}/include
libdir=${prefix}/lib

pl_has_d3d11=0
pl_has_dovi=1
pl_has_gl_proc_addr=1
pl_has_glslang=1
pl_has_lcms=1
pl_has_libdovi=0
pl_has_opengl=1
pl_has_shaderc=0
pl_has_vk_proc_addr=1
pl_has_vulkan=1
pl_has_xxhash=0

Name: libplacebo
Description: Reusable library for GPU-accelerated video/image rendering
Version: 7.360.1
Requires.private: lcms2 >= 2.9
Libs: -L${libdir} -lplacebo
Libs.private: -lm -pthread -lglslang -lglslang-default-resource-limits /data/data/com.termux/files/usr/lib/libSPIRV.so -ldl -lvulkan
Cflags: -I${includedir}
