prefix=/data/data/com.termux/files/usr
includedir=${prefix}/include
libdir=${prefix}/lib

Name: harfbuzz-gpu
Description: HarfBuzz GPU rasterization library
Version: 14.5.0
Requires: harfbuzz =  14.5.0
Requires.private: freetype2 >=  20.0.14, glib-2.0 >=  2.30.0, graphite2 >=  1.2.0
Libs: -L${libdir} -lharfbuzz-gpu
Libs.private: -lm -L${libdir} -lharfbuzz -pthread
Cflags: -I${includedir}/harfbuzz
