
prefix=/data/data/com.termux/files/usr
exec_prefix=${prefix}
includedir=/data/data/com.termux/files/usr/include
libdir=/data/data/com.termux/files/usr/lib

Name: libopenmpt
Description: Tracker module player based on OpenMPT
URL: https://lib.openmpt.org/
Version: 0.8.9+release.autotools
Requires.private: zlib libmpg123 ogg vorbis vorbisfile
Libs: -L${libdir} -lopenmpt
Libs.private:  
Cflags: -I${includedir}

