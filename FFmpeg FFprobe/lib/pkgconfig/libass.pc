prefix=/data/data/com.termux/files/usr
exec_prefix=${prefix}
libdir=/data/data/com.termux/files/usr/lib
includedir=/data/data/com.termux/files/usr/include

Name: libass
Description: libass is an SSA/ASS subtitles rendering library
Version: 0.17.5
Requires: 
Requires.private: fontconfig >= 2.10.92, harfbuzz >= 1.2.3, fribidi >= 0.19.1, freetype2 >= 9.17.3
Libs: -L${libdir} -lass 
Libs.private: -lm -liconv 
Cflags: -I${includedir}
