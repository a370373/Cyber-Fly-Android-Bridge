prefix=/data/data/com.termux/files/usr
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: x265
Description: H.265/HEVC video encoder
Version: 4.3
Libs: -L${libdir} -lx265
Libs.private: -landroid-posix-semaphore -lc++ -lm -l-l:libunwind.a -ldl -l-l:libunwind.a -ldl -lrt -ldl
Cflags: -I${includedir}
